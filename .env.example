# Server Configuration
PORT=5000
DEBUG=False
SECRET_KEY=cx02-sales-ai-secret-key-change-in-production

# Storage
DATABASE_PATH=data/sales_ai.db

# Pricing & Freshness Rules
PRICE_MAX_AGE_DAYS=14
# VAT configuration: default empty (unknown VAT treatment). Set VAT_RATE=0.05 and PRICES_INCLUDE_VAT=false to enable.
VAT_RATE=
PRICES_INCLUDE_VAT=

# Ollama / LLM Configuration (qwen2.5:7b fits 8GB VRAM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
FORCE_EXTRACTIVE_MODE=false

# WhatsApp Cloud API Webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=cx02_sales_verify_token
WHATSAPP_APP_SECRET=cx02_webhook_app_secret

# Kepler Tech LLC Contact Defaults
KEPLER_PHONE=00971 4 323 1008
KEPLER_WHATSAPP=+971 50 890 1641
KEPLER_ADDRESS=D79 Khalid Bin Waleed Road, Dubai
